PORT=5000
# MongoDB Atlas (free M0) or local: mongodb://127.0.0.1:27017/smart_health
MONGO_URI=mongodb://127.0.0.1:27017/smart_health
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Required to register an "admin" account from the Register page
ADMIN_SIGNUP_CODE=ADMIN-2026

# Doctor working hours are interpreted in this timezone (minutes from UTC).
# 330 = IST (UTC+05:30). Must be a multiple of 30.
SLOT_TZ_OFFSET_MINUTES=330

# Optional: real emails for reminders. Leave SMTP_HOST empty to use console/mock reminders.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart Health <no-reply@smarthealth.local>"
